# Text files with line endings
* text=auto eol=lf

# Specific files
*.dart text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.lrc text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.apk binary
*.aab binary
*.mp3 binary
*.wav binary
*.m4a binary
*.ogg binary
*.zip binary
*.jks binary
*.pdf binary

# Large files
builds/*.apk filter=lfs diff=lfs merge=lfs -text
builds/*.aab filter=lfs diff=lfs merge=lfs -text
