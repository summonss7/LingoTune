{
  "title": "04-Politeness-Phrases-Song",
  "artist": "LingoTune Arabic Learning",
  "originalLanguage": "ar",
  "translations": [
    {
      "language": "ru",
      "languageName": "Русский",
      "type": "",
      "lines": [
        {
          "startTime": 0.0,
          "text": "Мин фадляк",
          "translatedText": null,
          "transcript": "/mɪn fædˈlæk/",
          "originalStartTime": null
        },
        {
          "startTime": 5.0,
          "text": "Мин фадляк - аиз мин фадляк (пожалуйста - хочу, пожалуйста)",
          "translatedText": null,
          "transcript": "/mɪn fædˈlæk - ˈʔɑːjiːz mɪn fædˈlæk/",
          "originalStartTime": null
        },
        {
          "startTime": 10.0,
          "text": "Лу смахыт",
          "translatedText": null,
          "transcript": "/luː sˈmæħɪt/",
          "originalStartTime": null
        },
        {
          "startTime": 15.0,
          "text": "Лу смахыт - лу смахыт я хабиби (если позволишь - если позволишь, дорогой)",
          "translatedText": null,
          "transcript": "/luː sˈmæħɪt - luː sˈmæħɪt jɑː χæˈbiːbiː/",
          "originalStartTime": null
        },
        {
          "startTime": 20.0,
          "text": "Афуан",
          "translatedText": null,
          "transcript": "/ʔæˈfʊːˈæn/",
          "originalStartTime": null
        },
        {
          "startTime": 25.0,
          "text": "Афуан - афуан миннак (пожалуйста - пожалуйста от тебя)",
          "translatedText": null,
          "transcript": "/ʔæˈfʊːˈæn - ʔæˈfʊːˈæn ˈmɪnnæk/",
          "originalStartTime": null
        },
        {
          "startTime": 30.0,
          "text": "Хазыр",
          "translatedText": null,
          "transcript": "/χɑːˈziːr/",
          "originalStartTime": null
        },
        {
          "startTime": 35.0,
          "text": "Хазыр - хазыр маак (готов - готов с тобой)",
          "translatedText": null,
          "transcript": "/χɑːˈziːr - χɑːˈziːr mɑːˈʔæk/",
          "originalStartTime": null
        },
        {
          "startTime": 40.0,
          "text": "Таммам",
          "translatedText": null,
          "transcript": "/tæˈmɑːm/",
          "originalStartTime": null
        },
        {
          "startTime": 45.0,
          "text": "Таммам - таммам я саиди (хорошо - хорошо, господин)",
          "translatedText": null,
          "transcript": "/tæˈmɑːm - tæˈmɑːm jɑː sæˈjiːdiː/",
          "originalStartTime": null
        },
        {
          "startTime": 50.0,
          "text": "Мабсут",
          "translatedText": null,
          "transcript": "/mæbˈsuːt/",
          "originalStartTime": null
        },
        {
          "startTime": 55.0,
          "text": "Мабсут - мабсут джиддан (доволен - очень доволен)",
          "translatedText": null,
          "transcript": "/mæbˈsuːt - mæbˈsuːt dʒɪdˈdɑːn/",
          "originalStartTime": null
        },
        {
          "startTime": 60.0,
          "text": "Ма ас-саляма",
          "translatedText": null,
          "transcript": "/mæʔ æs sæˈlɑːmæ/",
          "originalStartTime": null
        },
        {
          "startTime": 65.0,
          "text": "Ма ас-саляма - ма ас-саляма я гали (до свидания - до свидания, дорогой)",
          "translatedText": null,
          "transcript": "/mæʔ æs sæˈlɑːmæ - mæʔ æs sæˈlɑːmæ jɑː ɣɑːˈliː/",
          "originalStartTime": null
        },
        {
          "startTime": 70.0,
          "text": "Салям",
          "translatedText": null,
          "transcript": "/sæˈlɑːm/",
          "originalStartTime": null
        },
        {
          "startTime": 75.0,
          "text": "Салям - салям я сахиби (пока - пока, друг)",
          "translatedText": null,
          "transcript": "/sæˈlɑːm - sæˈlɑːm jɑː sæˈhiːbiː/",
          "originalStartTime": null
        },
        {
          "startTime": 80.0,
          "text": "Бас хейр",
          "translatedText": null,
          "transcript": "/bɑːs χejr/",
          "originalStartTime": null
        },
        {
          "startTime": 85.0,
          "text": "Бас хейр - бас хейр я батыль (всего доброго - всего доброго, герой)",
          "translatedText": null,
          "transcript": "/bɑːs χejr - bɑːs χejr jɑː bɑːˈtiːl/",
          "originalStartTime": null
        },
        {
          "startTime": 90.0,
          "text": "Я рабб",
          "translatedText": null,
          "transcript": "/jɑː ræb/",
          "originalStartTime": null
        },
        {
          "startTime": 95.0,
          "text": "Я рабб - я рабб тийи (надеюсь - надеюсь, придешь)",
          "translatedText": null,
          "transcript": "/jɑː ræb - jɑː ræb tɪˈjiː/",
          "originalStartTime": null
        },
        {
          "startTime": 100.0,
          "text": "Раббуня ихлялик",
          "translatedText": null,
          "transcript": "/rɑbˈbʊnjæ ʔɪχˈlɑːjɪk/",
          "originalStartTime": null
        },
        {
          "startTime": 105.0,
          "text": "Раббуня ихлялик - раббуня ихлялик лина (Бог тебя хранит - Бог хранит тебя для нас)",
          "translatedText": null,
          "transcript": "/rɑbˈbʊnjæ ʔɪχˈlɑːjɪk - rɑbˈbʊnjæ ʔɪχˈlɑːjɪk lɪˈnɑː/",
          "originalStartTime": null
        },
        {
          "startTime": 110.0,
          "text": "Алла ябарак фик",
          "translatedText": null,
          "transcript": "/ʔɑlˈlɑː jɑːˈbɑːræk fɪk/",
          "originalStartTime": null
        },
        {
          "startTime": 115.0,
          "text": "Алла ябарак фик - фик хейр (Бог благословит тебя - в тебе добро)",
          "translatedText": null,
          "transcript": "/ʔɑlˈlɑː jɑːˈbɑːræk fɪk - fɪk χejr/",
          "originalStartTime": null
        }
      ]
    }
  ]
}